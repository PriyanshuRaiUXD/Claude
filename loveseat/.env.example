# ─────────────────────────────────────────────────────────────────────────────
# Loveseat configuration. Copy to .env and edit:  cp .env.example .env
# Every value is optional for local development — the app runs with none of them.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port for the API + WebSocket server (Vite dev server runs on 5173 and proxies here).
PORT=3001

# Public origin of the app, used for Stripe redirect URLs. REQUIRED in production.
# APP_URL=https://loveseat.example.com

# Number of reverse proxies in front of Node (for correct client IPs in rate limiting). 0 = none.
TRUST_PROXY=0

# Where rooms, purchases and processed webhook ids are stored (one JSON file).
DATA_DIR=./data

# ── Stripe ───────────────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to use the built-in DEMO checkout (no money moves).
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3001/api/stripe/webhook` locally,
# or the signing secret of your Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=
# Optional: an existing recurring Price for Couples Pro. Without it, $7.99/month is defined inline.
STRIPE_PRO_PRICE_ID=
# Production only: allow the simulated checkout when no Stripe key is set (never do this for real users).
ALLOW_DEMO_BILLING=false

# ── Free tier limits ─────────────────────────────────────────────────────────
FREE_SESSION_MINUTES=60
# After a free session ends, streaming stays locked this long (calls keep working).
FREE_COOLDOWN_MINUTES=20
# How long a dropped partner keeps their seat while reconnecting.
RECONNECT_GRACE_SECONDS=10

# ── WebRTC networking ────────────────────────────────────────────────────────
# Comma-separated STUN URLs (default: Google's public STUN).
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relay: needed for roughly 1 in 10 connections (strict NAT, corporate/mobile networks).
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Either static credentials…
# TURN_USERNAME=
# TURN_CREDENTIAL=
# …or a coturn static-auth-secret (short-lived credentials are minted per join):
# TURN_SECRET=
# Or replace everything with a full JSON list of ICE servers:
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# ── Lobby ads (free rooms, pre-stream lobby only) ────────────────────────────
# Google AdSense. When both are set, AdSense fills the lobby slot.
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT=0000000000
# Otherwise house/sponsor ads rotate. Point to a JSON array of
# {id, sponsor, title, body, cta, href} where href is https://… or action:pass|pro|gifts
# ADS_FILE=./ads.json
